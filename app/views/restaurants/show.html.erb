<div class="container my-3">

  <%= link_to '< All Restaurants', restaurants_path, class: "btn btn-outline-primary my-3"%>

  <div class="card shadow-sm p-4">
    <div class="card-body">

      <h3 class="card-title"><%= @restaurant.name %></h3>
      <h5 class="card-subtite"><%= @restaurant.category.capitalize %> cusine</h5>
      <p class="card-text">Phone Number: <%= @restaurant.phone_number %>
      <br>Address: <%= @restaurant.address %></p>

      <div id="reviews-container" class="mt-4">
        <%# <h4 class="mb-3">Reviews</h4> %>
        <%# link_to 'Leave a Review', new_restaurant_review_path(@restaurant), class: "btn btn-sm btn-primary my-3"%>

        <% @reviews.each do |review| %>
          <div class="card text-bg-light shadow-sm mb-3">
            <div class="card-body">
              <h5 class="card-title"><%= review.rating %> Stars</h5>
              <p class="card-text"><%= review.content %></p>
            </div>
          </div>
        <% end %>

        <div class="card text-bg-light shadow-sm">
          <div class="card-header">
            <h5>Leave a Review</h5>
          </div>
          <div class="card-body">
            <%= simple_form_for [@restaurant, @review] do |f| %>
              <%= f.input :rating, collection: @rating%>
              <%= f.input :content %>
              <%= f.button :submit, class: "btn mt-3 btn-primary" %>
            <% end %>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>
