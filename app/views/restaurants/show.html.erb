<div class="container my-3">
  <%= link_to '< All Restaurants', restaurants_path, class: "btn btn-outline-primary my-3"%>
  <div class="card shadow-sm p-4">
    <div class="card-body">
      <h3 class="card-title"><%= @restaurant.name %></h3>
      <h5 class="card-subtite"><%= @restaurant.category.capitalize %> cusine</h5>
      <p class="card-text">Phone Number: <%= @restaurant.phone_number %>
      <br>Address: <%= @restaurant.address %></p>
      <div id="reviews-container" class="mt-5">
        <h4>Reviews</h4>
        <% @reviews.each do |review| %>
          <div class="row mt-3">
            <div class="card text-bg-light shadow-sm">
              <div class="card-body">
                <h5 class="card-title"><%= review.rating %> Stars</h5>
                <p class="card-text"><%= review.content %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
